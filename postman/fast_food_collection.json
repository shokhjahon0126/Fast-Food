        {
          "name": "Delete Cashier",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/cashiers/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "cashiers", "1", ""]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "User Profile",
      "item": [
