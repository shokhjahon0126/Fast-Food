              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"kassir_bekzod\",\n  \"password\": \"123456\",\n  \"first_name\": \"Bekzod\",\n  \"last_name\": \"Usmonov\",\n  \"phone\": \"+998901234599\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/cashiers/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "cashiers", ""]
            }
          },
          "response": []
