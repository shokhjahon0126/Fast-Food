{
  "info": {
    "_postman_id": "fast-food-api-collection-v1",
    "name": "Fast-Food API Collection",
    "description": "Fast-Food loyihasi uchun barcha API endpointlari to'plami",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Customer (Mijoz ro'yxatdan o'tishi)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mijoz_bobur\",\n  \"password\": \"parol123\",\n  \"first_name\": \"Bobur\",\n  \"last_name\": \"Alimov\",\n  \"phone\": \"+998901234567\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/register/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "register", ""]
            },
            "description": "Ommaviy ro'yxatdan o'tish (Public Register). Rol avtomatik ravishda 'customer' qilib belgilanadi."
          },
          "response": []
        },
        {
          "name": "Login (JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "login", ""]
            },
            "description": "Foydalanuvchi tizimga kirishi va access/refresh tokenlarini olishi uchun endpoint."
          },
          "response": [
            {
              "name": "200 OK - Muvaffaqiyatli kirish",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"refresh\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"access\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"id\": 1,\n  \"role\": \"admin\"\n}"
            }
          ]
        },
        {
          "name": "Token Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/refresh/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "refresh", ""]
            }
          },
          "response": []
        }
      ]
    },
